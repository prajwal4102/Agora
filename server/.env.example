AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
AGENT_GREETING=Hi! Ask me what time it is.
MCP_ENDPOINT=https://<your-tunnel>/mcp
OPENAI_MODEL=gpt-4o-mini
# Pipeline is Agora-managed by default. Set a key for BYO; override the URL if needed.
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
# Realtime mode uses a separate OpenAI API key.
# OPENAI_REALTIME_API_KEY=sk-your-openai-key
# OPENAI_REALTIME_MODEL=gpt-realtime
# Murf Falcon is the agent's voice (required).
MURF_API_KEY=your_murf_api_key
# MURF_VOICE_ID=Anisha
# MURF_LOCALE=en-IN        # leave empty to let Murf detect the language from text
# STT_LANGUAGE=en          # "multi" follows Hindi-English code switching

# Real phone calls through Twilio (optional). app = web phone page, phone = real mobiles.
# CALL_MODE=app
# TWILIO_FROM_NUMBER=+14155550123
# TWILIO_SIP_ADDRESS=yourname.pstn.twilio.com
# TWILIO_SIP_USERNAME=
# TWILIO_SIP_PASSWORD=
# EMPLOYEE_PHONE=+91XXXXXXXXXX
# SUPERVISOR_PHONE=+91XXXXXXXXXX
